package com.FunctionDemos;

public class D06FunctionOverloading {

	public static void calAddition1(int n1, int n2, int n3)
	{
		int ans = n1 + n2 + n3;
		System.out.println("Answer: " + ans);
	}
	public static void calAddition2(int n1, int n2)
	{
		int ans = n1 + n2;
		System.out.println("Answer: " + ans);
	}
	public static void calAddition3(double n1, double n2)
	{
		double ans = n1 + n2;
		System.out.println("Answer: " + ans);
	}
	public static void calAddition4(int n1, double n2)
	{
		double ans = n1 + n2;
		System.out.println("Answer: " + ans);
	}
	public static void calAddition5(double n1, int n2)
	{
		double ans = n1 + n2;
		System.out.println("Answer: " + ans);
	}
	
	public static void main(String[] args) {
		// TODO Auto-generated method stub

	}

}
